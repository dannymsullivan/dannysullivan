---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import SessionCards from '../components/SessionCards.astro';

const examples = [
  { number: '01', title: 'Make sense of the information.', problem: '“I have the data. I need the decision.”', description: 'Work through a spreadsheet, compare options, or turn scattered research into a brief you can act on.' },
  { number: '02', title: 'Get time back in your week.', problem: '“There has to be a better way to do this.”', description: 'Take a recurring report, planning task, or follow-up process and develop a repeatable way to do it with AI.' },
  { number: '03', title: 'Move an idea into action.', problem: '“I know what I want. How do I build it?”', description: 'Explore a business idea, map out a useful internal tool, or create a first prototype together.' },
];
---

<MarketingLayout title="AI for Business Leaders | Danny Sullivan" description="Private AI education and consulting for CEOs, founders, and business leaders. Learn with your real work in a 60-minute remote session, or start with a free 20-minute discovery call.">
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-copy">
      <p class="eyebrow"><span class="small-dot" aria-hidden="true"></span> Private AI education & consulting</p>
      <h1 id="hero-heading">Make AI part of<br />how you <em>lead.</em></h1>
      <p class="hero-description">You know your business. Let’s make AI work for it.</p>
      <p class="hero-detail">Private, hands-on sessions for CEOs, founders, and ambitious business leaders. Learn with your real work, guided by an educator who builds AI products.</p>
      <div class="hero-actions">
        <a class="button" href="/book/#discovery">Start with a free discovery call <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="/book/#private-session">Explore private sessions <span aria-hidden="true">→</span></a>
      </div>
      <p class="hero-footnote">One-to-one. Remote. No technical background required.</p>
    </div>
    <aside class="session-preview" aria-label="What a private session looks like">
      <div class="preview-top"><span>A working session with Danny</span><span>1:1</span></div>
      <p class="preview-heading">Your work.<br />Your next <em>breakthrough.</em></p>
      <div class="preview-step"><span>01</span><div><h2>Bring a real challenge.</h2><p>The report, the process, the idea that’s on your mind.</p></div></div>
      <div class="preview-step"><span>02</span><div><h2>Work through it together.</h2><p>Share your screen. Try the tools. Ask every question.</p></div></div>
      <div class="preview-step"><span>03</span><div><h2>Know how to do it again.</h2><p>Understand the process, and where your judgment matters.</p></div></div>
      <div class="preview-person"><img src="/danny-sullivan.jpg" alt="" width="44" height="44" /><div><strong>Danny Sullivan</strong><span>Educator. Product engineer. Your guide.</span></div></div>
    </aside>
  </section>

  <div class="experience-strip" aria-label="Danny’s background">
    <p>Grounded in building.<br /><strong>Experienced in teaching.</strong></p>
    <div><strong>Gametime</strong><span>Product Engineer</span></div>
    <div><strong>Pluralsight</strong><span>Former Staff Author, Generative AI</span></div>
    <div><strong>George Washington University</strong><span>MA, Education & Human Development</span></div>
  </div>

  <section class="section" id="approach" aria-labelledby="approach-heading">
    <div class="section-intro"><p class="eyebrow">The approach</p><h2 id="approach-heading">Start with the work<br />in front of <em>you.</em></h2><p>AI becomes useful when you can apply it to something that matters. Every session starts with your challenge and moves at your pace.</p></div>
    <div class="example-grid">
      {examples.map((example) => <article class="example"><span class="item-number">{example.number}</span><h3>{example.title}</h3><p class="example-quote">{example.problem}</p><p>{example.description}</p></article>)}
    </div>
  </section>

  <section class="tool-position" aria-labelledby="tools-heading">
    <div><p class="eyebrow">A point of view, an open mind</p><h2 id="tools-heading">Codex is my go-to.<br /><em>Your goal sets the direction.</em></h2></div>
    <div><p>I prefer Codex and use it in my own work. I’ll show you how I use it, explain my choices, and help you recognize when another tool fits the job.</p><p>Already using ChatGPT, Claude, or Gemini? We can start there. You’re here to develop skills and judgment you can take from one tool to the next.</p></div>
  </section>

  <section class="section" aria-labelledby="sessions-heading">
    <div class="section-intro session-intro"><div><p class="eyebrow">Work with me</p><h2 id="sessions-heading">A small first step.<br />A more capable <em>you.</em></h2></div><p>See what’s possible in a discovery call, or give a bigger challenge your full attention in a private session.</p></div>
    <SessionCards />
  </section>

  <section class="about-section" id="about" aria-labelledby="about-heading">
    <div class="about-photo"><img src="/danny-sullivan.jpg" alt="Danny Sullivan smiling" width="615" height="615" loading="lazy" /><span>Danny Sullivan / Educator & builder</span></div>
    <div class="about-copy"><p class="eyebrow">Your guide</p><h2 id="about-heading">A teacher’s patience.<br />A builder’s <em>perspective.</em></h2><p>I’m Danny. I build AI products at Gametime. Before that, I was a Staff Author for Generative AI, senior creative technologist, and curriculum manager at Pluralsight.</p><p>Teaching has always been part of my work, from special education to technical curriculum. I have a master’s in Education and Human Development from George Washington University. Before tech, I also played professional baseball.</p><p>I bring that experience to our sessions: clear explanations, room to ask questions, and practice that helps you become more capable.</p><a class="text-link" href="/book/">Let’s work on something that matters to you <span aria-hidden="true">↗</span></a></div>
  </section>

  <section class="closing" aria-labelledby="closing-heading"><p class="eyebrow">Let’s make it useful</p><h2 id="closing-heading">Bring one problem.<br />Let’s solve it <em>live.</em></h2><p>A free 20-minute discovery call. Pick one small challenge, and we’ll get to work.</p><a class="button" href="/book/#discovery">Explore the free discovery call <span aria-hidden="true">↗</span></a></section>
</MarketingLayout>
