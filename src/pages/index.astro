---
import ResumeLayout from '../layouts/ResumeLayout.astro';
const competencies = [
  { skill: 'AI strategy & adoption', evidence: 'Identify AI opportunities, make them tangible, and guide company-wide transformation.', context: 'Gametime' },
  { skill: 'Applied AI systems', evidence: 'Build agent workflows, source assessments, image generation, independent QA, and operator-controlled publishing.', context: 'Seatview' },
  { skill: 'Engineering judgment', evidence: 'Design durable execution, bounded spend, retry/cancellation controls, reproducible instructions, and evidence-based review.', context: 'Seatview' },
  { skill: 'Experimentation & evaluation', evidence: 'Test models and visual workflows, inspect failure patterns, revise quality criteria, and simplify execution when tighter controls work better.', context: 'Gametime / Pluralsight' },
  { skill: 'Teaching & organizational adoption', evidence: 'Provide company-wide AI guidance. Create hands-on AI learning and explain technical work to executives and teams.', context: 'Gametime / Pluralsight' },
];
const decisions = [
  { title: 'Control spend before a request starts', body: 'Shared database reservations account for concurrent workers before a paid call. Reported usage settles the estimate; unknown usage keeps its allowance. Resuming work preserves the same run budget. An application spending guard is distinct from a provider billing cap.' },
  { title: 'Make retries safe around paid operations', body: 'Persist session, tool-call, candidate, and review state. Replay a saved tool result without generating another image. Stop on an uncertain render outcome. Permit at most two image attempts; a passing result cannot trigger a cosmetic retry.' },
  { title: 'Separate camera, layout, and appearance', body: 'The original photo owns the viewpoint and permanent sightlines. The event map owns the temporary layout. Style references affect appearance. Independent review judges actual pixels against those authorities; the gap workflow stops without a verified source camera.' },
  { title: 'Use an agent loop where it earns its complexity', body: 'The managed Agents API path supports saved sessions and a narrowly scoped edit_source tool. New Autopilot work uses direct application-controlled rendering and bounded, tool-free Responses API visual checks. Existing sessions remain inspectable under their original protocol.' },
  { title: 'Keep long-running jobs accountable', body: 'Temporal advances durable steps. Leases, revision checks, run fences, and configuration/layout/section identity prevent duplicate work and stale writes. Cancellation, changed layouts, and newer human choices win over late worker results.' },
  { title: 'Bind approval to the artifact that ships', body: 'Source/generated comparisons make decisions inspectable. The server confirms exact selected photo and layout identities, then rejects changed artifacts or altered submissions. Generation, AI acceptance, human approval, and publication remain distinct states.' },
];
---
<ResumeLayout title="Danny Sullivan | Applied AI Leader & Engineer" description="Technical resume: AI systems engineering at Gametime, hands-on agent systems engineering with Seatview, and generative AI education at Pluralsight.">
  <section class="resume-profile" id="profile" aria-labelledby="profile-title">
    <div class="profile-main"><p class="resume-label"><span></span> AI leadership / Engineering / Education</p><h1 id="profile-title">Danny Sullivan<span>.</span></h1><h2>Applied AI leader.<br />Hands-on engineer.<br />Experienced educator.</h2><p class="profile-summary">I build AI systems at Gametime and guide company-wide AI transformation. My work spans business priorities, production software, constant experimentation, and teaching.</p><div class="profile-actions"><a class="resume-primary" href="mailto:hello@dannysullivan.ai?subject=AI%20leadership%20opportunity">Discuss an AI leadership role <span>↗</span></a><a class="resume-secondary" href="#seatview">See the work ↓</a></div></div>
    <aside class="profile-card"><img src="/danny-sullivan.jpg" alt="Danny Sullivan" width="615" height="615" /><div><p>Currently</p><strong>Gametime</strong><span>Product Engineer</span><span>January 2026 – present</span></div><div><p>Previously</p><strong>Pluralsight</strong><span>Sr. Creative Technologist<br />Staff Author, Generative AI</span></div><div><p>Focus</p><span>AI leadership roles connecting strategy, engineering, and adoption.</span></div></aside>
  </section>
  <section class="qualification-section" aria-labelledby="qualifications-title"><div class="resume-section-heading"><p class="resume-label">Qualifications / Evidence</p><h2 id="qualifications-title">What I bring to the role.</h2></div><div class="qualification-table">{competencies.map(item => <article><h3>{item.skill}</h3><p>{item.evidence}</p><span>{item.context}</span></article>)}</div></section>
  <section class="resume-project" id="seatview" aria-labelledby="seatview-title"><div class="resume-section-heading"><p class="resume-label">02 / Flagship system</p><h2 id="seatview-title">Seatview<span class="project-company">Gametime</span></h2><p class="resume-subtitle">An AI system for event-specific seat-view imagery.</p></div>
    <div class="project-summary"><div><span class="resume-label">The business problem</span><p>Ticket buyers need to understand the view from their seat. Missing photos create uncertainty; the wrong viewpoint can misrepresent the experience. Coverage has to keep up with venues, sections, event types, and changing stage layouts.</p></div><div><span class="resume-label">My responsibility</span><p>Own the work from discovery and experimentation through implementation and iteration: coverage intelligence, source discovery, generation, quality review, and the workflow used to approve and publish photos.</p></div></div>
    <div class="project-flow" aria-label="Seatview workflow"><div><span>01</span><strong>Prioritize</strong><p>GMV + coverage gaps</p></div><i aria-hidden="true">→</i><div><span>02</span><strong>Verify</strong><p>Source + exact map</p></div><i aria-hidden="true">→</i><div><span>03</span><strong>Generate</strong><p>Bounded image edits</p></div><i aria-hidden="true">→</i><div><span>04</span><strong>Review</strong><p>Independent visual QA</p></div><i aria-hidden="true">→</i><div><span>05</span><strong>Publish</strong><p>Human-confirmed set</p></div></div>
    <div class="project-evidence"><article><h3>Business prioritization</h3><p>Rank upcoming events by realized transaction GMV and identify gaps in the exact configuration. Shared event layouts share generation work.</p></article><article><h3>Agent systems engineering</h3><p>Integrate the Agents API, persist session and tool state, constrain operations, and evolve toward bounded checks where appropriate.</p></article><article><h3>Operational product design</h3><p>Give operators source/result comparisons, actionable findings, cost visibility, recovery controls, and an explicit publication boundary.</p></article></div>
    <div class="project-stack"><span class="resume-label">Implementation</span><div>{['TypeScript','Next.js / React','OpenAI Agents API','Responses + Images APIs','Temporal','PostgreSQL / Drizzle','Snowflake','AWS S3 / CloudFront'].map(tool => <span>{tool}</span>)}</div></div>
    <div class="project-decisions"><div class="decisions-heading"><h3>Engineering decisions worth looking at</h3><p>Expand for the implementation detail.</p></div>{decisions.map((decision,i) => <details><summary><span>{String(i+1).padStart(2,'0')}</span><strong>{decision.title}</strong><b aria-hidden="true">+</b></summary><p>{decision.body}</p></details>)}</div>
    <div class="project-foot"><p><strong>Evidence:</strong> implemented workflows, recorded local generation/QA pilots, database integration tests, and browser checks. The evolving Autopilot path still needs representative quality/cost evaluation and production verification.</p><a href="/work/seatview/">Full technical walkthrough <span aria-hidden="true">↗</span></a></div>
  </section>
  <section class="resume-experience" id="experience" aria-labelledby="experience-title"><div class="resume-section-heading"><p class="resume-label">03 / Experience</p><h2 id="experience-title">Building and teaching,<br />across the same career.</h2></div>
    <article class="experience-entry"><div class="experience-date">JAN 2026 — PRESENT</div><div><div class="experience-role"><h3>Gametime</h3><span>Product Engineer</span></div><ul><li><strong>AI transformation:</strong> provide company-wide guidance on applying AI to real business problems.</li><li><strong>End-to-end ownership:</strong> build and iterate on Seatview, connecting photo-coverage needs with generation, classification, review, and publishing.</li><li><strong>Internal tools:</strong> built Creative Hub to give content teams self-service access to photo sourcing, generation, and publication.</li><li><strong>Data and delivery:</strong> built a Snowflake-backed coverage agent and restructured S3 / CloudFront image delivery for production use.</li><li><strong>Exploration and adoption:</strong> continually test new AI capabilities, including spatial/3D workflows, and teach teams how to apply and evaluate them.</li></ul><div class="experience-tools">AI agents · TypeScript · React · Python · Snowflake · AWS · Temporal</div></div></article>
    <article class="experience-entry"><div class="experience-date">APR 2022 — JAN 2026</div><div><div class="experience-role"><h3>Pluralsight</h3><span>Sr. Creative Technologist & Staff Author, Generative AI</span></div><ul><li><strong>Executive communication:</strong> presented AI prototypes to executives and the board using working demonstrations and clear technical explanations.</li><li><strong>Applied experimentation:</strong> explored video models and ways to extend existing content into new labs and courses.</li><li><strong>Technical education:</strong> authored hands-on AI/ML labs across LLMs, transformers, model evaluation, semantic search, and PyTorch.</li></ul><div class="experience-tools">Generative AI · Python · LLMs · Model evaluation · PyTorch · Learning design</div></div></article>
    <article class="experience-entry"><div class="experience-date">APR 2017 — AUG 2019</div><div><div class="experience-role"><h3>2U</h3><span>Sr. Curriculum Engineer</span></div><ul><li>Engineered and delivered a 12-week MERN-stack bootcamp with a small development team.</li><li>Managed backlogs, GitHub issues, and continuous curriculum improvements.</li></ul><div class="experience-tools">MongoDB · Express · React · Node.js · Curriculum engineering</div></div></article>
    <article class="experience-entry"><div class="experience-date">MAR 2016 — APR 2017</div><div><div class="experience-role"><h3>UltraLinq Healthcare Solutions</h3><span>Software Engineer</span></div><ul><li>Built Python / Flask APIs and microservices for medical imaging and reporting in a HIPAA-compliant healthcare environment.</li></ul><div class="experience-tools">Python · Flask · APIs · Medical imaging</div></div></article>
    <article class="experience-entry"><div class="experience-date">SEP 2012 — MAR 2016</div><div><div class="experience-role"><h3>Creative Loafing Tampa</h3><span>Software Developer</span></div><ul><li>Built and maintained Ruby on Rails products supporting community events and print-distribution operations.</li></ul><div class="experience-tools">Ruby on Rails · Web applications · Operations</div></div></article>
  </section>
  <section class="resume-expertise" id="expertise" aria-labelledby="expertise-title"><div class="resume-section-heading"><p class="resume-label">04 / Technical expertise</p><h2 id="expertise-title">Depth across the delivery stack.</h2></div><div class="expertise-grid"><article><span>01 / AI systems</span><h3>Models to workflows</h3><p>Agent integration, tool contracts, prompt and context design, structured outputs, visual evaluation, semantic search, multimodal generation.</p></article><article><span>02 / Engineering</span><h3>Applications to infrastructure</h3><p>TypeScript, JavaScript, Python, React, Next.js, Node.js, Flask, PostgreSQL, Temporal, Snowflake, AWS, S3, CloudFront, GitHub.</p></article><article><span>03 / Leadership</span><h3>Strategy to adoption</h3><p>AI strategy, opportunity discovery, rapid prototyping, technical storytelling, executive demonstrations, cross-company guidance, hands-on teaching.</p></article></div></section>
  <section class="resume-education" id="education" aria-labelledby="education-title"><div class="resume-section-heading"><p class="resume-label">05 / Education</p><h2 id="education-title">A foundation in how people learn.</h2></div><div class="education-row"><h3>The George Washington University</h3><p>M.A., Education & Human Development<br />B.A., Psychology</p></div><div class="education-row"><h3>Flatiron School</h3><p>Web Development<br />Completed training; subsequently taught for one semester.</p></div></section>
  <section class="resume-contact" id="contact"><div><p class="resume-label">Next role</p><h2>AI leadership with<br />real engineering depth.</h2><p>Interested in teams turning frontier AI into useful products and organizational capability.</p></div><a class="resume-primary" href="mailto:hello@dannysullivan.ai?subject=AI%20leadership%20opportunity">Contact Danny <span>↗</span></a></section>
