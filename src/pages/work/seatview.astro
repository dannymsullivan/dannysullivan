<script>
  for (const explorer of document.querySelectorAll<HTMLElement>('[data-workflow]')) {
    const links = Array.from(explorer.querySelectorAll<HTMLAnchorElement>('[data-stage-link]'));
    const panels = Array.from(explorer.querySelectorAll<HTMLElement>('[data-stage-panel]'));
    const select = (id: string) => {
      for (const link of links) {
        if (link.dataset.stageLink === id) link.setAttribute('aria-current', 'step');
        else link.removeAttribute('aria-current');
      }
      for (const panel of panels) panel.hidden = panel.dataset.stagePanel !== id;
    };
    const fromHash = () => links.find(link => link.hash === location.hash)?.dataset.stageLink;
    select(fromHash() ?? links[0].dataset.stageLink!);
    explorer.classList.add('enhanced');
    for (const link of links) link.addEventListener('click', event => {
      event.preventDefault();
      select(link.dataset.stageLink!);
      history.replaceState(null, '', link.hash);
    });
    window.addEventListener('hashchange', () => { const id = fromHash(); if (id) select(id); });
  }
</script>
