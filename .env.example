# Public Cal.com event URLs, e.g. https://cal.com/your-name/discovery.
# The paid event must require payment through Stripe during booking.
# Leave blank to offer an explicit email request instead of an unconnected checkout.
PUBLIC_DISCOVERY_BOOKING_URL=https://cal.com/danny-sullivan/discovery
PUBLIC_SESSION_BOOKING_URL=https://cal.com/danny-sullivan/ai-for-business-leaders

# Agreed launch rate. Match the actual paid event price in USD.
# Required when the paid booking URL is configured.
PUBLIC_SESSION_PRICE_USD=249
